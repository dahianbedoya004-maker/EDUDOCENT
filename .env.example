# EDUDOCENT - Configuración de Variables de Entorno (Ejemplo)
# Copia este archivo con el nombre '.env' y coloca tus claves:

# Key de Google Gemini AI (para respuestas de Inteligencia Artificial en vivo)
VITE_GEMINI_API_KEY=tu_gemini_api_key_aqui

# Credenciales de EmailJS (para envío de correos 2FA a la bandeja de entrada real)
VITE_EMAILJS_SERVICE_ID=tu_service_id_aqui
VITE_EMAILJS_TEMPLATE_ID=tu_template_id_aqui
VITE_EMAILJS_PUBLIC_KEY=tu_public_key_aqui

# Configuración de Base de Datos y Backend Supabase
VITE_SUPABASE_URL=https://gqbpjqjxrwmeziulefaq.supabase.co
VITE_SUPABASE_ANON_KEY=tu_supabase_anon_key_aqui
